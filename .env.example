# Optional: only when the default Hugging Face checkpoint is gated (it is not gated today).
HF_TOKEN=

# Optional override for the strands-decider checkpoint id
DECIDER_MODEL=StrandsAgents/strands-decider-2B-qwen3.5-v1-2610

# Device passed to strands-decider load_engine (cpu, mps, cuda, mlx)
DECIDER_DEVICE=cpu

# Required in CI keyless jobs; set to 1 so Hub downloads fail closed
HF_HUB_OFFLINE=1

# Telemetry opt-out for Hugging Face Hub clients
HF_HUB_DISABLE_TELEMETRY=1

# Generic telemetry opt-outs
DO_NOT_TRACK=1
DISABLE_TELEMETRY=1
