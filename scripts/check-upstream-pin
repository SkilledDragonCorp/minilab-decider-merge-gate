#!/usr/bin/env python3
"""Fail unless ./upstream HEAD is the pinned strands-decider commit."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
PIN = "8b6faa553038a59e73fa7f16c4081f8ceb21d27e"


def main() -> int:
    upstream = ROOT / "upstream"
    if not (upstream / ".git").exists() and not (ROOT / ".gitmodules").is_file():
        print("missing upstream submodule", file=sys.stderr)
        return 1
    head = subprocess.check_output(
        ["git", "-C", str(upstream), "rev-parse", "HEAD"],
        text=True,
    ).strip()
    if head != PIN:
        print(f"upstream HEAD {head} != pin {PIN}", file=sys.stderr)
        return 1
    print(head)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
